[Unit]
Description=AI Music Intelligence Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-music
Group=ai-music
WorkingDirectory=/opt/ai-music
Environment=PYTHONUNBUFFERED=1
Environment=FLASK_HOST=127.0.0.1
Environment=FLASK_PORT=5000
EnvironmentFile=-/opt/ai-music/.env
ExecStart=/opt/ai-music/.venv/bin/gunicorn --workers 2 --threads 2 --timeout 90 --bind 127.0.0.1:5000 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
